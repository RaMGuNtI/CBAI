# CustomBot AI Configuration

# Secret Key for JWT Tokens
SECRET_KEY=custombot-ai-super-secret-key-change-in-production-2025

# Database URL
DATABASE_URL=sqlite:///storage/custombot.db

# LLM Providers (Configure one or both, or leave blank to use the built-in grounded mock LLM)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default Models
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_URL=http://127.0.0.1:8000

